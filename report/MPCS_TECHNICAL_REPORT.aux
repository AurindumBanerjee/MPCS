\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Multi-Layer Retrieval \& Spreading Activation Cascade.} Layer~1 executes exact $O(k)$ hash matching in $27\,\mu \text  {s}$. Layer~2 applies hard predicate safety exclusions, pruning $98\%$ of candidate records in sub-millisecond time. Layer~3 (TIDE) seeds spreading activation with arousal gain, propagating energy across typed episode edges under strict anytime deadline budgets ($1.25 \sim 1.54\,\text  {ms}$).}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:mem_index}{{3}{6}{\textbf {Multi-Layer Retrieval \& Spreading Activation Cascade.} Layer~1 executes exact $O(k)$ hash matching in $27\,\mu \text {s}$. Layer~2 applies hard predicate safety exclusions, pruning $98\%$ of candidate records in sub-millisecond time. Layer~3 (TIDE) seeds spreading activation with arousal gain, propagating energy across typed episode edges under strict anytime deadline budgets ($1.25 \sim 1.54\,\text {ms}$)}{figure.3}{}}
