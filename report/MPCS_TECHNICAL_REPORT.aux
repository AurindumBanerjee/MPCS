\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Empirical Quantitative Benchmark Suite on Bank v3 ($700$ Records, $960$ Queries).} (A)~Action recommendation accuracy comparing clean vs.\ noisy queries across indexing schemes and MPCS generations. (B)~Safety violation rate (\texttt  {Unsafe Action \%}), highlighting the $26\times $ reduction achieved by HyST hard-slot gating ($31.2\% \rightarrow 1.2\%$). (C)~TIDE anytime deadline budget curve demonstrating the ``Less-is-More'' semantic foraging effect ($71.9\%$ accuracy at $B=3$ vs.\ $64.8\%$ at Full Read). (D)~TIDE epistemic sufficiency routing accuracy under non-urgent deliberation (\texttt  {DIRECT} $97.3\%$ clean accuracy vs.\ \texttt  {SUBGRAPH} $76.1\%$).}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:bench_plots}{{5}{11}{\textbf {Empirical Quantitative Benchmark Suite on Bank v3 ($700$ Records, $960$ Queries).} (A)~Action recommendation accuracy comparing clean vs.\ noisy queries across indexing schemes and MPCS generations. (B)~Safety violation rate (\texttt {Unsafe Action \%}), highlighting the $26\times $ reduction achieved by HyST hard-slot gating ($31.2\% \rightarrow 1.2\%$). (C)~TIDE anytime deadline budget curve demonstrating the ``Less-is-More'' semantic foraging effect ($71.9\%$ accuracy at $B=3$ vs.\ $64.8\%$ at Full Read). (D)~TIDE epistemic sufficiency routing accuracy under non-urgent deliberation (\texttt {DIRECT} $97.3\%$ clean accuracy vs.\ \texttt {SUBGRAPH} $76.1\%$)}{figure.5}{}}
