\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Dual-Persona Query Routing \& Topological Subgraph Partitioning.} Influx query terms seed initial activation with lexical and somatic arousal weights. Spreading activation computes normalized node scores. The query engine branches according to persona mode: Confident Persona applies a strict $45\%$ relative cutoff for core isolation, while Exploratory Persona incorporates secondary associative nodes ($18\%$ cutoff). Edges are dynamically partitioned into internal green links vs. external dashed pink bridging links.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:dual_persona}{{4}{7}{\textbf {Dual-Persona Query Routing \& Topological Subgraph Partitioning.} Influx query terms seed initial activation with lexical and somatic arousal weights. Spreading activation computes normalized node scores. The query engine branches according to persona mode: Confident Persona applies a strict $45\%$ relative cutoff for core isolation, while Exploratory Persona incorporates secondary associative nodes ($18\%$ cutoff). Edges are dynamically partitioned into internal green links vs. external dashed pink bridging links}{figure.4}{}}
