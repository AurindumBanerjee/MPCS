# Local LLM via Ollama
# One or more Ollama endpoints, comma-separated. Requests are spread round-robin
# with automatic failover (local replacement for rotating multiple Grok API keys).
OLLAMA_HOSTS=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600
OLLAMA_MAX_RETRIES=3
OLLAMA_KEEP_ALIVE=30m
# Disable "thinking" for reasoning models (qwen3, deepseek-r1). Leave empty for model default.
OLLAMA_THINK=false
# Concurrent chunk requests. Match OLLAMA_NUM_PARALLEL on the server x number of hosts.
EXTRACT_WORKERS=2
RATE_LIMIT_RPM=6000
USE_MOCK_LLM=false

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ChromaDB
CHROMA_DIR=data/chroma

# Pipeline
SCHEMA_VERSION=v1
PROMPT_VERSION=extract_v1
